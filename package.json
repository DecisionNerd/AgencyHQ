{
  "name": "agencyhq",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node --test tests/architecture-baseline.test.mjs",
    "test": "pnpm check",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "trigger:dev": "pnpm --filter @agencyhq/trigger dev",
    "trigger:trial": "pnpm --filter @agencyhq/trigger trial"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "typescript": "^5.9",
    "@types/node": "^24"
  }
}
