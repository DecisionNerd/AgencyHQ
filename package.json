{
  "name": "agencyhq",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node --test tests/architecture-baseline.test.mjs tests/dependency-rules.test.mjs tests/compose-config.test.mjs tests/no-session-paths.test.mjs",
    "test": "pnpm check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "test:all": "pnpm test && pnpm test:integration",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:browser": "pnpm --filter @agencyhq/web test:browser",
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose -f infra/db/compose.yaml up -d",
    "db:down": "docker compose -f infra/db/compose.yaml down",
    "trigger:dev": "pnpm --filter @agencyhq/trigger dev",
    "trigger:trial": "pnpm --filter @agencyhq/trigger trial"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "typescript": "^5.9",
    "@types/node": "^24"
  }
}
