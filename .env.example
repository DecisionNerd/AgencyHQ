# Root .env.example — optional overrides for the AgencyHQ container profile.
#
# Copy to .env and uncomment/edit only the values you want to change.
# All values here are optional; the stack works without this file.
#
# IMPORTANT: No secrets belong in this file. Internal credentials are
# generated by the secrets-init service and stored in the secrets volume.
# See infra/secrets/README.md for how secret management works.
#
# For local development (running the coordinator from the host with a
# local database), see infra/db/compose.yaml and set DATABASE_URL,
# RUNTIME, TRIGGER_API_URL, etc. directly in your shell or a local
# untracked .env (never commit secrets).

# ── Platform ──────────────────────────────────────────────────────────────────
# Target platform for all AgencyHQ images and task image builds.
# linux/arm64 is the default platform on this host (arm64 macOS); exercised in L1 on one host.
# linux/amd64 is declared as "built by the same recipe, not yet exercised" unless
# a CI runner builds and smokes it (see ADR-0008).
# AGENCYHQ_PLATFORM=linux/arm64

# ── Default models ────────────────────────────────────────────────────────────
# opencode/big-pickle is the default model (zero spend); not yet exercised in a provider qualification trial.
# See infra/README.md § "Provider setup" for alternatives.
# AGENCYHQ_WORKER_MODEL=opencode/big-pickle
# AGENCYHQ_LEAD_MODEL=opencode/big-pickle
# AGENCYHQ_REVIEWER_MODEL=opencode/big-pickle

# ── Worker slots ──────────────────────────────────────────────────────────────
# Number of concurrent task runner containers.
# AGENCYHQ_WORKER_SLOTS=1

# ── Bootstrap email ───────────────────────────────────────────────────────────
# Email address used by the bootstrap container to create the Trigger org/project.
# Must match ADMIN_EMAILS and WHITELISTED_EMAILS set in the Trigger webapp.
# AGENCYHQ_BOOTSTRAP_EMAIL=bootstrap@agencyhq.local

# ── Published ports ───────────────────────────────────────────────────────────
# All ports default to 127.0.0.1 (loopback only).
# Override in compose.override.yaml (preferred) or here.
# AGENCYHQ_APP_PORT=8787
# AGENCYHQ_POSTGRES_PORT=5435
